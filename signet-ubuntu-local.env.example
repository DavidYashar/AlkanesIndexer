# Native bitcoind runs directly on the Ubuntu laptop.
# Docker services connect back to the host through Docker's host-gateway alias.

HOST_SIGNET_RPC_HOSTPORT=host.docker.internal:38332
HOST_SIGNET_RPC_USER=alkanesrpc
HOST_SIGNET_RPC_PASSWORD=replace-with-your-bitcoind-rpc-password

# memshrew still needs Bitcoin P2P access for signet block data.
HOST_SIGNET_P2P_ADDR=host.docker.internal:38333

# Public explorer/read side stays on Mempool unless you later self-host electrs.
SIGNET_ESPLORA_URL=https://mempool.space/signet/api

# Only needed when you run the optional data-api profile.
INFURA_ENDPOINT=https://mainnet.infura.io/v3/YOUR_KEY